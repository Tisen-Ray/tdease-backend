# Development Environment Variables
# Feature flag for new visualization viewers (disabled by default during migration)
VITE_USE_NEW_VIEWERS=false
VITE_API_BASE_URL=http://127.0.0.1:8000

# WebSocket connection — connect directly to the backend in dev.
# The Vite dev server proxy (ws: true) does not reliably forward WebSocket
# upgrades for all paths; direct connection avoids this limitation.
VITE_WS_URL=ws://localhost:8000
