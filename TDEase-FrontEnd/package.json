{
  "name": "tdease-frontend",
  "private": true,
  "version": "0.1.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "desktop:dev": "node scripts/electron-dev.cjs",
    "desktop:build": "pnpm run build && electron-builder --dir --config electron-builder.json",
    "desktop:dist": "pnpm run build && electron-builder --config electron-builder.json",
    "test": "vitest",
    "test:run": "vitest run",
    "gate:workflow": "node scripts/gate-tests.mjs workflow",
    "gate:visualization": "node scripts/gate-tests.mjs visualization",
    "gate:ai-workspace": "node scripts/gate-tests.mjs ai-workspace",
    "gate:current": "node scripts/gate-tests.mjs current && pnpm run build",
    "test:gate:workflow": "pnpm run gate:workflow",
    "test:gate:visualization": "pnpm run gate:visualization",
    "test:gate:ai-workspace": "pnpm run gate:ai-workspace",
    "test:e2e": "playwright test",
    "test:e2e:local-prod": "pnpm exec playwright test --config=../playwright-frontend.config.ts ../tests/e2e/workflow-rungraph.spec.ts ../tests/e2e/workflow-ui-states.spec.ts"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@iconify-json/catppuccin": "^1.2.17",
    "@iconify/vue": "^5.0.0",
    "@tanstack/vue-query": "^5.92.9",
    "@types/dagre": "^0.7.54",
    "@uppy/core": "^5.2.0",
    "@uppy/dashboard": "^5.1.1",
    "@uppy/tus": "^5.1.1",
    "@uppy/xhr-upload": "^5.1.1",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.0",
    "@vue-flow/minimap": "^1.5.4",
    "@vueuse/core": "^14.2.1",
    "ag-grid-community": "^34.3.1",
    "ag-grid-vue3": "^34.3.1",
    "d3": "^7.9.0",
    "dagre": "^0.8.5",
    "dompurify": "^3.3.3",
    "element-plus": "^2.11.8",
    "loglevel": "^1.9.2",
    "markdown-it": "^14.1.1",
    "pinia": "^3.0.4",
    "plotly.js-dist-min": "^3.7.0",
    "vue": "^3.5.25",
    "vue-i18n": "^11.4.6",
    "vue-router": "^4.6.3",
    "vue-virtual-scroller": "^2.0.1",
    "vue3-plotly-ts": "^1.0.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intlify/unplugin-vue-i18n": "^11.2.4",
    "@playwright/test": "^1.60.0",
    "@types/d3": "^7.4.3",
    "@types/loglevel": "^1.6.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.6.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "eslint": "^10.5.0",
    "eslint-plugin-vue": "^10.9.2",
    "fast-check": "^4.3.0",
    "happy-dom": "^20.8.3",
    "jsdom": "^29.0.0",
    "pyright": "^1.1.410",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.61.1",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.0.3",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vitest": "^4.0.14",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.1.10",
    "wait-on": "^8.0.3"
  }
}
